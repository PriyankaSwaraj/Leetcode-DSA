class Solution {
    public int[] shortestToChar(String s, char c) {
    ArrayList<Integer> arr = new ArrayList<Integer>();
    int n=s.length();
    for(int i=0;i<n;i++)
    {
        if(s.charAt(i)==c)
        {
            arr.add(i);
        }
    }
    int m =arr.size();
    int[] nums=new int[n];
    for(int i=0;i<n;i++)
    {
        int min=n+1;
        for(int j=0;j<m;j++)
        {
            int a=Math.abs(arr.get(j)-i);
            min= Math.min(min,a);
        }
        nums[i]=min;
    } 
    return nums;
    }
}
