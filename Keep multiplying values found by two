class Solution {
    public int findFinalValue(int[] nums, int original) {
        int n=nums.length,check=0;
        Arrays.sort(nums);
        while(check<1)
        {
            int low=0,high=n-1,test=0;
            while(low<=high)
            {
                int mid = (low+high)/2;
                if(nums[mid]==original)
                {
                    original *= 2;
                    test += 1;
                    break;
                }
                else if(nums[mid]>original){
                    high = mid-1;
                }
                else{
                    low = mid+1;
                }
            }
            if(test<1)
            {
                check += 1;
            }
        }
        return original;
    }
}
