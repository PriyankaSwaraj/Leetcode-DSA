class Solution {
    public boolean canPlaceFlowers(int[] flowerbed, int n) {
    int m = flowerbed.length;
    if(flowerbed[0]==0&&(m<2||flowerbed[1]==0))
    {
        flowerbed[0]=1;
        n--;
    }
    if(m>2&&flowerbed[m-1]==0&&flowerbed[m-2]==0)
    {
        flowerbed[m-1]=1;
        n--;
    }
    for(int i=1;i<m-1;i++)
    {
        if(flowerbed[i]==0&&flowerbed[i-1]==0&&flowerbed[i+1]==0)
        {
            flowerbed[i]=1;
            n--;
        }
    }
    return n<1;
    }
}
