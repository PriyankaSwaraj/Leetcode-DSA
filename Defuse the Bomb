class Solution {
    public int[] decrypt(int[] code, int k) {
     int n = code.length;
     int[] arr = new int[n];
     for(int i=0;i<n;i++)
     {
        int j=0,sum=0,count=0;
        if(k>0)
        {
         j=i+1;
         while(count<k)
         {
            if(j==n)
            {
                j=0;
            }
            sum += code[j];
            j++;
            count++;
         }
        }
         else if(k<0)
         {
            j=i-1;
            while(count<(-k))
            {
            if(j<0)
            {
                j=n-1;
            }
            sum += code[j];
            j--;
            count++; 
            }
         }
         arr[i]=sum;
       }
     return arr; 
    }
}
