class Solution {
    public int maxProfit(int[] prices) {
     int sum =0,n=prices.length;
     int min = prices[0],check=0;
     for(int i=1;i<n-1;i++)
     {
        min = Math.min(min,prices[i]);
        if(prices[i]>min)
        {
            check +=1;
        }
        if(prices[i]>prices[i+1])
        {
            sum += prices[i]-min;
            min = prices[i];
            check=0;
        }
        
     }
     if(n>1&&(prices[n-1]>prices[n-2]||check>0))
     {
        sum += prices[n-1]-min;
     }
     return sum;
    }
}
