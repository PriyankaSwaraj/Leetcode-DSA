class Solution {
    public String convertToTitle(int columnNumber) {
       String str ="";
    while(columnNumber>0)
    {
        int b=columnNumber%26;
        if(b==0)
        {
            b=26;
            columnNumber -= 1;
        }
        char ch =(char)(b+64);
        str += Character.toString(ch);
        columnNumber /= 26;
    }
     StringBuilder sb = new StringBuilder(str);
    return sb.reverse().toString();
    }
}
