class Solution {
    public int sumOddLengthSubarrays(int[] arr) {
     int sum=0,n=arr.length;
     for(int i=0;i<n;i++)
     {
        int count=0,sum1=0;
        for(int j=i;j<n;j++)
        {
            count++;
            sum1 += arr[j];
            if(count%2!=0)
            {
                sum += sum1;
            } 
        }
     }
      return sum;
    }
}
