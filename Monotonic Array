class Solution {
    public boolean isMonotonic(int[] nums) {
    int n = nums.length, a=0;
    for(int i=1;i<n;i++)
    {
        if(nums[i-1]!=nums[i])
        {
            a = nums[i]-nums[i-1];
            break;
        }
    }
    if(n>1&&a>0) 
    {
        for(int i=1;i<n;i++)
        {
            if(nums[i]<nums[i-1])
            {
                return false;
            }
        }
    }  
    else {
        for(int i=1;i<n;i++)
        {
            if(nums[i]>nums[i-1])
            {
                return false;
            }
        }
    }
        return true;
    }
}
