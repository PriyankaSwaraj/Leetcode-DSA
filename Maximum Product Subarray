class Solution {
    public int maxProduct(int[] nums) {
    int product =0,check=0;
    for(int i=0;i<nums.length;i++)
    {
        int pro =1;
        for(int j=i;j<nums.length;j++)
        {
            pro *= nums[j];
            if(check==0)
            {
                product =pro;
            }
            product = Math.max(pro,product);
            check++;
        }
    }
    return product;
    }
}
