class Solution {
    public int minimumFlips(int n) {
    String s="";
     while(n>0)
         {
             int a = n%2;
             n=n/2;
             s += Integer.toString(a);
         }
        int count =0,m=s.length();
        for(int i=0,j=m-1;i<m/2;i++,j--)
            {
                if(s.charAt(i)!=s.charAt(j))
                {
                    count +=2;
                }
            }
        return count;
    }
}
