class Solution {
    public boolean checkIfExist(int[] arr) {
     Arrays.sort(arr);
     int n=arr.length;;
     for(int i=0;i<n;i++)
     {
        int low=0,high=n-1;
     while(low<=high)
     {
       int mid=(low+high)/2;
       if(arr[mid]==arr[i]*2&&i!=mid)
       {
        return true;
       }
       else if(arr[mid]>arr[i]*2)
       {
        high = mid-1;
       }
       else{
        low = mid+1;
       }
     }  
     }
     return false; 
    }
}
