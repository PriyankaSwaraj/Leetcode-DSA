lass Solution {
    public boolean canThreePartsEqualSum(int[] arr) {
    int sum=0,n=arr.length;
    for(int i=0;i<n;i++)
    {
        sum += arr[i];
    } 
    double d= (double)sum/3;
    sum /=3;
    int count=0,sum1=0;
    for(int i=0;i<n;i++)
    {
        sum1 += arr[i];
        if(sum1==sum)
        {
            sum1=0;
            count++;
        }
        if(count==3)
        {
            break;
        }
    }   
    return d%1==0&&count==3;
    }
}
