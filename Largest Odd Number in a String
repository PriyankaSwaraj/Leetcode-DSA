import java.math.BigInteger;
class Solution {
    public String largestOddNumber(String num) {
    int n =num.length();
    for(int i=n-1;i>=0;i--)
    {
        int no = Character.getNumericValue(num.charAt(i));
        if(no%2!=0)
        {
            return num.substring(0,i+1);
        }
    }
 return "";
    }
}
