class Solution {
    public int findLengthOfLCIS(int[] nums) {
     int count=1,count2=1,n=nums.length;
     for(int i=1;i<n;i++)
     {
        if(nums[i]>nums[i-1])
        {
            count++;
            count2 = Math.max(count2,count);
        }
        else{
            count =1;
        }
     }   
     return count2;
    }
}
