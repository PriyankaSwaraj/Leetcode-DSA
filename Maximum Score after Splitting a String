class Solution {
    public int maxScore(String s) {
     int n = s.length();
     int[] zero = new int[n];
     int[] ones =new int[n];
     int z=0,o=0;
     for(int i=0,j=n-1;i<n;i++,j--)
     {
       if(s.charAt(i)=='0')
       {
        z += 1;
       }
       if(s.charAt(j)=='1')
       {
        o += 1;
       }
       zero[i]=z;
       ones[j]=o;
     }
     int maxi=0;
     for(int i=1;i<n-1;i++)
     {
        maxi = Math.max(maxi,zero[i]+ones[i]);
     }
     if(n<3)
     {
        maxi=Math.max(maxi,zero[0]+ones[1]);
     }
     return maxi;
    }
}
