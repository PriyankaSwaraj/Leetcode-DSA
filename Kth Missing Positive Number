class Solution {
    public int findKthPositive(int[] arr, int k) {
    int n = arr.length; 
    int val=1;
    for(int i=0;i<n;i++)
    {
      if(i>0&&arr[i]==arr[i-1])
      {
        continue;
      }
      if(val!=arr[i])
      {
        while(val<arr[i])
        {
        nums.add(val);
        val++;
        }
      }
      val++;
    }
    int num=arr[n-1]+1;
    while(nums.size()<=k)
    {
        nums.add(num);
        num++;
    }
    return nums.get(k-1);
    }
}
