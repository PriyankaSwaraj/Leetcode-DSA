class Solution {
    public boolean isAnagram(String s, String t) {
       if(s.length()!=t.length())
       {
        return false;
       }
      Character[] arr1 = new Character[s.length()];
      Character[] arr2 = new Character[t.length()];
      for(int i=0;i<s.length();i++) 
      {
        arr1[i] = s.charAt(i);
        arr2[i] = t.charAt(i);
      }
      Arrays.sort(arr1);
      Arrays.sort(arr2);
      for(int i=0;i<s.length();i++)
      {
        if(arr1[i]!=arr2[i])
        {
            return false;
        }
      }
      return true;
    }
}
