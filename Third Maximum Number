class Solution {
    public int thirdMax(int[] nums) {
    int max1=Integer.MIN_VALUE,max2=Integer.MIN_VALUE,max3=Integer.MIN_VALUE,n=nums.length,check=0;
    for(int i=0;i<n;i++)
    {
        int x=nums[i];
        if(x==Integer.MIN_VALUE)
        {
            check++;
        }
        if(x==max1||x==max2||x==max3)
        {
            continue;
        }
      if(x>max1)
      {
        max3=max2;
        max2=max1;
        max1=x;
      }
      else if(x>max2){
        max3=max2;
        max2=x;
      }
      else if(x>max3)
      {
        max3 = x;
      }
    }
    if(check<1&&max3==Integer.MIN_VALUE)
    {
        return max1;
    } 
    if(max1==max2||max2==max3)
    {
        return max1;
    }
    return max3; 
    }
}
    
