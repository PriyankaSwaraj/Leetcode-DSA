class Solution {
    public String convertToBase7(int num) {
        if(num==0)
        {
            return "0";
        }
    int check =0;
    if(num<0)
    {
        check += 1;
        num = -num;
    }
    String str ="";
    while(num>0)
    {
        str += Integer.toString(num%7);
        num /= 7;
    } 
    String s ="";
    if(check>0)
    {
        s += "-";
    } 
    for(int i=str.length()-1;i>=0;i--)
    {
        s += str.charAt(i);
    }  
    return s;
    }
}
