class Solution {
    public int longestSubarray(int[] nums) {
     int count=2,co=2;
     for(int i=2;i<nums.length;i++)
         {
             if(nums[i-1]+nums[i-2]==nums[i])
             {
                 co++;
             }
             else{
                count = Math.max(count,co);
                 co=2;
             }
         }
        count= Math.max(co,count);
        return count;
    }
}
