class Solution {
    public String[] findRelativeRanks(int[] score) {
     int n=score.length;
     int[] arr =Arrays.copyOf(score, n);
     Arrays.sort(arr);
     String[] rank = new String[n];
     for(int i=0;i<n;i++)
     {
        for(int j=0;j<n;j++)
        {
            if(score[i]==arr[j])
            {
                j = n-j-1;
                if(j==0)
                {
                    rank[i]="Gold Medal";
                }
                else if(j==1)
                {
                    rank[i]="Silver Medal";
                }
                else if(j==2)
                {
                    rank[i]="Bronze Medal";
                }
                else{
                    rank[i]=Integer.toString(j+1);
                }
                break;
            }
        }
     }

     return rank;   
    }
}
