class Solution {
    public String defangIPaddr(String address) {
     String s="[.]",str="";
     int n = address.length();
     for(int i=0;i<n;i++)
     {
        if(address.charAt(i)=='.')
        {
            str +=s; 
        }
        else{
            str +=Character.toString(address.charAt(i));
        }
     }   
     return str;
    }
}
