class Solution {
    public int valueAfterKSeconds(int n, int k) {
    int[] arr = new int[n];
    arr[0] =1;
    while(k>=0)
    {
        for(int i=1;i<n;i++)
        {
            int a= (arr[i]+arr[i-1])%1000000007;
            arr[i] = a;
        }
        k--;
    }    
    return arr[n-1];
    }
}
