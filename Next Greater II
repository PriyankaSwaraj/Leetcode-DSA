class Solution {
    public int[] nextGreaterElements(int[] nums) {
     int n = nums.length;
     int[] arr = new int[n];
     for(int i=0;i<n;i++)
     {
        int check=0,n1=n;
        for(int j=i+1;j<n&&n1>0;j++)
        {
            if(nums[j]>nums[i])
            {
                arr[i] =nums[j];
                check  += 1;
                break;
            }
             if(j==n-1)
            {
                j=-1;
            }
            n1--;      
     }
      if(check<1)
        {
            arr[i]=-1;
        }
     }
     for(int i=0;i<n-1;i++)
     {
        if(nums[i]>nums[n-1])
        {
            arr[n-1]=nums[i];
            break;
        }
     }
     return arr;
    }
}
