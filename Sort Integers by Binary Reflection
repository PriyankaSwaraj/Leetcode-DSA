class Solution {
    public int[] sortByReflection(int[] nums) {
        int n=nums.length;
     int[] arr = new int[n];
        for(int i=0;i<n;i++)
            {
                String str="";
                int num=nums[i];
                while(num>0)
                    {
                        str += Integer.toString(num%2);
                        num /= 2;
                    }
                int m=str.length(),b=0;
                for(int j=m-1,k=0;j>=0;j--,k++)
                    {
                      if(str.charAt(j)=='1')
                      {
                          b += Math.pow(2,k);
                      }
                    }
                arr[i]=b;
            }
        for(int i=0;i<n;i++)
            {
                for(int j=0;j<n-1;j++)
                    {
                        if(arr[j]>arr[j+1]||(arr[j]==arr[j+1]&&nums[j]>nums[j+1]))
                        {
                            int temp = nums[j];
                            nums[j]=nums[j+1];
                            nums[j+1]=temp;
                            int t=arr[j];
                            arr[j]=arr[j+1];
                            arr[j+1]=t;
                        }
                        
                    }
            }
        return nums;
    }
   
}
