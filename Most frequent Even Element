class Solution {
    public int mostFrequentEven(int[] nums) {
     Arrays.sort(nums);
     int k=-1,count=0;
     for(int i=0;i<nums.length;i++)
     {
        if(nums[i]%2==0)
        {
            int  co =1;
            for(int j=i+1;j<nums.length;j++)
            {
                if(nums[j]!=nums[i])
                {
                    break;
                }
                co++;
            }
            if(co>count)
            {
                count =co;
                k= nums[i];
            }
        }
     }
     return k;
    }
}
