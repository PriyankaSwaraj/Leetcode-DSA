class Solution {
    public int maximizeExpressionOfThree(int[] nums) {
    int max1 =-111,max2=-111,min=nums[0],n=nums.length;
        for(int i=0;i<n;i++)
            {
                if(nums[i]>max1)
                {
                    max2=max1;
                    max1=nums[i];
                }
                else if(nums[i]>max2)
                {
                    max2 = nums[i];
                }
                min = Math.min(min,nums[i]);
            }
        return (max1+max2)-min;
    }
}
