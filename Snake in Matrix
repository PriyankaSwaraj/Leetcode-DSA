class Solution {
    public int finalPositionOfSnake(int n, List<String> commands) {
     int m= commands.size();
     int i=0,j=0,k=0;
     while(m>0)
     {
        if(commands.get(k).equals("RIGHT"))
        {
            j += 1;
        }
        else if(commands.get(k).equals("LEFT"))
        {
            j -= 1;
        }
        else if(commands.get(k).equals("UP"))
        {
            i -= 1;
        }
        else{
            i += 1;
        }
        m -= 1;
        k += 1;
    } 
     return (i * n) + j;  
    }
}
