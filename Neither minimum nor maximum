class Solution {
    public int findNonMinOrMax(int[] nums) {
    int max=nums[0],min=nums[0],n=nums.length;
    for(int i=1;i<n;i++)
    {
        max = Math.max(max,nums[i]);
        min = Math.min(min,nums[i]);
    }    
    for(int i=0;i<n;i++)
    {
        if(nums[i]!=max&&nums[i]!=min)
        {
            return nums[i];
        }
    }
    return -1;
    }
}
