class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
  Arrays.sort(nums);
  ArrayList<Integer> arr = new ArrayList<Integer>();
  int k=1,n=nums.length;
  for(int i=1;i<n;i++)
  {
    if(nums[i]!=nums[i-1])
    {
    nums[k] = nums[i];
    k++;
    }
  }
  int j=1;
 for(int i=0;i<n&&j<n+1;i++,j++)
 {
       if(nums[i]!=j)
       {
        while(nums[i]!=j&&j!=n+1)
        {
            arr.add(j);
            j++;
        }
       }
 }
 if(nums[k-1]!=n&&j<n)
 {
  arr.add(n);
 }
return arr;
    }
}
