class Solution {
    public boolean check(int[] nums) {
      int n = nums.length;
      int[] arr = new int[n];
      for(int i=0;i<n;i++)
      {
        arr[i]=nums[i];
      }
      Arrays.sort(arr);
      for(int j=0;j<n;j++)
      {
        if(Arrays.equals(arr,nums))
        {
            return true;
        }
        int a = nums[n-1];
        for(int i=n-1;i>0;i--)
        {
            nums[i]=nums[i-1];
        }
        nums[0]=a;
      }
      return false;
    }
}
