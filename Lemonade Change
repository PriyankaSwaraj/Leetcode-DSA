class Solution {
    public boolean lemonadeChange(int[] bills) {
     int five=0,ten=0,n=bills.length;
     for(int i=0;i<n;i++)
     {
        if(bills[i]>5)
        {
            int num=bills[i]-5;
            if(num>5&&ten>0)
            {
                num -= 10;
                ten--;
            }
            if(num>0&&five>0)
            {
                while(num>0&&five>0)
                {
                num -= 5;
                five--;
                }
            }
            if(num>0)
            {
                return false;
            }
        }
        if(bills[i]==5)
        {
            five += 1;
        }
        else if(bills[i]==10)
        {
            ten += 1;
        }
     }
     return true;
    }
      }  
    
