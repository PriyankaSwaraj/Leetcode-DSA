class Solution {
    public int firstMissingPositive(int[] nums) {
    Arrays.sort(nums);
    int n = nums.length;
    if(nums[n-1]<0||nums[0]>1)
    {
        return 1;
    }
    for(int i=0;i<n;i++)
    {
       if(nums[i]>0)
       {
        for(int j=i,k=0;j<n;j++)
        {
            if(j==0||(nums[j]!=nums[j-1]))
            {
                k++;
            }
            if(nums[j]!=k)
            {
                return k;
            }
        }
        break;
       }
    }
    return nums[n-1]+1;
    }
}
