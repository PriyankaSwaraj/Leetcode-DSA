class Solution {
    public int minimumDistance(int[] nums) {
    int x =1000,n=nums.length;
        int[] arr = new int[3];
       int  v=-1;
     for(int i=0;i<n;i++)
         {
             int count=0,index=0;
             for(int j=i;j<n&&index<3;j++)
                 { 
                     if(nums[i]==nums[j])
                     {
                         arr[index]=j;
                         index++;
                         count++;
                     }
                    
                 }
             if(count==3)
             {
                 int a=Math.abs(arr[0]-arr[1])+Math.abs(arr[1]-arr[2])+Math.abs(arr[2]-arr[0]);
                 x=Math.min(x,a);
                 v=nums[i];
             }
         }
        if(v>=0)
        {
            return x;
        }
        return -1;
    }
}
