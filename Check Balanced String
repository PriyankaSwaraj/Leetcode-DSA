class Solution {
    public boolean isBalanced(String num) {
    int sum1=0,sum2=0,n=num.length();
    for(int i=0;i<n-1;i += 2)
    {
        sum1 += Character.getNumericValue(num.charAt(i));
        sum2 += Character.getNumericValue(num.charAt(i+1));
    } 
    if(n%2!=0)
    {
        sum1 += Character.getNumericValue(num.charAt(n-1));
    }
    if(sum1==sum2)
    {
        return true;
    }
    return false;   
    }
}
