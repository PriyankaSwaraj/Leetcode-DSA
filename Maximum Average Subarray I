class Solution {
    public double findMaxAverage(int[] nums, int k) {
     double max=-10000;
     int n=nums.length;
     for(int i=0;i<=n-k;i++)
     {
        int sum =0;
        for(int j=i;j<k+i&&j<n;j++)
        {
            sum += nums[j];
        }
        double avg = (double)(sum)/k;
        max = Math.max(avg,max);
     }
     return max;
    }
}
