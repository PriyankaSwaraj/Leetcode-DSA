import java.math.BigInteger;
class Solution {
    public int[] plusOne(int[] digits) {
    int n= digits.length;
    digits[n-1] = digits[n-1]+1;
    for(int i=n-1;i>0;i--)
    {
        if(digits[i]>9)
        {
            digits[i] =0;
            digits[i-1]= digits[i-1]+1;
        }
    }
    if(digits[0]>9)
    {
        int[] arr = new int[n+1];
        arr[0]=1;
        arr[1] =0;
        for(int i=1;i<n;i++)
        {
            arr[i+1] = digits[i];
        }
        return arr;
    }
    return digits;
    }
}
