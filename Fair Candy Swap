class Solution {
    public int[] fairCandySwap(int[] aliceSizes, int[] bobSizes) {
    int sum1=0,sum2=0,m=aliceSizes.length,n=bobSizes.length;
    for(int i=0;i<m;i++)
    {
        sum1 += aliceSizes[i];
    }    
    for(int i=0;i<n;i++)
    {
         sum2 += bobSizes[i];
    }
    int[] arr = new int[2];
    for(int i=0;i<m;i++)
    {
        sum1 -= aliceSizes[i];
     for(int j=0;j<n;j++)
     {
        int a= sum1+bobSizes[j];
        int b= sum2-bobSizes[j];
        b += aliceSizes[i];
        if(a==b)
        {
            arr[0]=aliceSizes[i];
            arr[1] = bobSizes[j];
        }
     }
      sum1 += aliceSizes[i];
    }
    return arr;
    }
}
