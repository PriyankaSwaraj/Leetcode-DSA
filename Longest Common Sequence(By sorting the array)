public int longestConsecutive(int[] nums) {
     Arrays.sort(nums);
     int max=1,curr=1,n=nums.length;
     if(n<1)
     {
        return 0;
     }
     for(int i=1;i<n;i++)
     {
        if(nums[i]==nums[i-1])
        {
            continue;
        }
      if(nums[i-1]+1==nums[i])
      {
        curr++;
      }
      else{
        curr=1;
      }
      max=Math.max(max,curr);
     }
     
     return max;
    }
