class Solution {
    public char findTheDifference(String s, String t) {
        int n= s.length(),m=t.length();
    for(int i=m-1;i>=0;i--)
    {
        int count1=0,count2=0;
        char ch = t.charAt(i);
        for(int j=0;j<n;j++)
        {
            if(s.charAt(j)==ch)
            {
                count1++;
            }
        }
        for(int j=0;j<m;j++)
        {
            if(t.charAt(j)==ch)
            {
                count2++;
            }
        }
        if(count1!=count2)
        {
            return ch;
        }
    } 
    return ' ';
    }
}
