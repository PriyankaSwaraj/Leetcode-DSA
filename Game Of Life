class Solution {
    public void gameOfLife(int[][] board) {
        int n = board.length;
        int[][] board1 = new int[board.length][board[0].length];

for (int i = 0; i <board.length; i++) {
    System.arraycopy(board[i], 0, board1[i], 0, board[i].length);
}

    for(int i=0;i<n;i++)
    {
        int m =board[i].length;
        for(int j=0;j<m;j++)
        {
            int count=0;
            if(i!=0)
            {
                if(board1[i-1][j]==1)
                {
                count += 1;
                }
                if(j!=0&&board1[i-1][j-1]==1)
                {
                    count += 1;
                }
                if(j!=m-1&&board1[i-1][j+1]==1)
                {
                    count += 1;
                }
            }
            if(i!=n-1)
            {
                if(board1[i+1][j]==1)
                {
                    count += 1;
                }
                if(j!=0&&board1[i+1][j-1]==1)
                {
                    count += 1;
                }
                if(j!=m-1&&board1[i+1][j+1]==1)
                {
                    count += 1;
                }
            }
            if(j!=0&&board1[i][j-1]==1)
            {
                count +=1;
            }
            if(j!=m-1&&board1[i][j+1]==1)
            {
                count += 1;
            }
            if(count>3||count<2)
            {
                board[i][j]=0;
            }
            else if(board1[i][j]==1&&count<2)
            {
                board[i][j]=0;
            }
            else if(board1[i][j]==1&&count<4)
            {
                board[i][j]=1;
            }
            else if(board1[i][j]==1&&count>3)
            {
                board[i][j]=1;
            }
            else if(board1[i][j]==0&&count==3){
                board[i][j]=1;
            }
            else{
                board[i][j]=0;
            }
           
        }
      
    }    
    }
}
