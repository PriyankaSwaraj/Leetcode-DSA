class Solution {
    public int residuePrefixes(String s) {
    int count =0;
        int n = s.length();
    for(int i=0;i<n;i++)
        {
            HashSet<Character> arr = new HashSet<>();
            for(int j=0;j<=i;j++)
                {
                    arr.add(s.charAt(j));
                }
            int  ch=arr.size();
            int a=(i+1)%3;
            if(ch==a)
            {
                count += 1;
            }
        }
        return count;
    }
}
