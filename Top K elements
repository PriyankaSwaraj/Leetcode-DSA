class Solution {
    public int[] topKFrequent(int[] nums, int k) {
        if(nums.length<2)
        {
          return nums;
        }
    ArrayList<Integer> arr = new ArrayList<Integer>();
    ArrayList<Integer> arr1 = new ArrayList<Integer>();
    Arrays.sort(nums);
    int count=1;
    for(int i=1;i<nums.length;i++)
    {
        if(nums[i]!=nums[i-1])
        {
            arr.add(count);
            if(count<2)
            {
                arr1.add(i-count);
            }
            else{
            arr1.add(i-count+1); 
            }
            count=0;
        }
        count++;
         if(i==nums.length-1)
        {
            arr.add(count);
           arr1.add(i-count+1);
        }
    }
    int[] num= new int[k];
    for(int i=0;i<k;i++)
    {
      int max= Collections.max(arr);
      int j= arr.indexOf(max);
      arr.set(j,0);
      num[i] = nums[arr1.get(j)];
    }
    return num;
    }
}
